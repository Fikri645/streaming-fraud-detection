# Cloud Run image: the serving layer only (FastAPI /score + dashboard).
# Online features come from Upstash Redis via REDIS_URL env (rediss://...).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi uvicorn sse-starlette pydantic redis \
    lightgbm "scikit-learn>=1.4,<1.6" joblib pandas numpy

COPY src/ src/
COPY api/ api/
COPY models/ models/

# Cloud Run injects PORT
ENV PORT=8080
CMD exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT}
